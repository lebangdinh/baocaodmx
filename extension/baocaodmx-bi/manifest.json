{
  "manifest_version": 3,
  "name": "SKST Cụm 933 — Lấy BI & tự nhập",
  "version": "1.2.9",
  "description": "Tự lấy đủ Thi đua Lũy kế/Realtime theo số chương trình BI hiển thị; kiểm tra từng dòng trước khi tự nhập SKST.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://baocao.dienmayxanh.com/*",
    "https://lebangdinh.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Đồng bộ SKST"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lebangdinh.github.io/baocaodmx/",
        "https://lebangdinh.github.io/baocaodmx/index.html",
        "https://lebangdinh.github.io/baocaodmx/bi-test.html"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://baocao.dienmayxanh.com/*"
      ],
      "js": [
        "recognition.js",
        "installment.js",
        "bi.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
